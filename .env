# URL base do back-end Java (ThicketHub).
# Aponta para http://localhost:8080/api no ambiente de desenvolvimento local.
# Altere para a URL de produção antes do deploy.
VITE_API_BASE_URL=http://localhost:8080/api

# Configuração Microsoft / Azure Entra ID para Login Institucional
# Insira o "ID do Aplicativo (cliente)" gerado no portal do Azure (portal.azure.com -> Microsoft Entra ID -> Registros de aplicativo):
VITE_AZURE_CLIENT_ID=5ad1ea35-bee9-4b76-9e7c-73c6e6849bf1
# Opcional: ID do diretório (locatário) caso seja restrito à sua organização (ou "common" para multilocatário):
VITE_AZURE_TENANT_ID=48dc6bea-1343-4391-8d16-ee31fe6cea34

